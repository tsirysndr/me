#!/bin/sh
# Compile the default keymap while building, rather than on the visitor's first keypress.
printf '%s\n' \
    'source /usr/local/share/blesh/ble.sh --noattach' \
    'ble-import keymap.emacs' \
    'test -s "$_ble_base_cache/keymap.emacs" || exit 1' \
    'exit 0' |
    TERM=xterm-256color LANG=C.UTF-8 script -q -e -c 'bash --noprofile --norc -i' /dev/null
