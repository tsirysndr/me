#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export TERM=xterm-256color
mkdir -p /dev /proc /sys
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts /run /tmp
mount -t devpts devpts /dev/pts
chmod 1777 /tmp
hostname browser
printf '127.0.0.1 localhost browser\n::1 localhost\n' > /etc/hosts
modprobe ne2k-pci
modprobe virtio_pci
modprobe virtio_console
ip link set lo up
# v86's WISP adapter gives each VM its own network with these fixed addresses.
ip addr add 192.168.86.100/24 dev eth0
ip link set eth0 up
ip route add default via 192.168.86.1
printf 'nameserver 192.168.86.1\n' > /etc/resolv.conf
exec </dev/hvc0 >/dev/hvc0 2>&1
printf '\033[2J\033[H'
printf 'Linux in your browser. Fish + real Unix commands.\n'
printf 'Files live in this tab; reload or restart resets Linux.\n\n'
while true; do
    setsid -c su - visitor
    printf '\r\nShell exited. Starting a new Fish session...\r\n'
done
