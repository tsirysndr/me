+/* --sort=tar: the files with data in tar stream order, one reference each */
+static LIST_HEAD(erofs_dataorder);
+
+void erofs_importer_order_data(struct erofs_importer *im,
+			       struct erofs_inode *inode)
+{
+	struct erofs_importer_params *params = im->params;
+
+	if (!params->data_in_tar_order)
+		return;
+	if (params->nofrag_first) {
+		inode->nofragment = true;
+		--params->nofrag_first;
+	}
+	list_add_tail(&inode->i_dataorder, &erofs_dataorder);
+	(void)erofs_igrab(inode);
+}
