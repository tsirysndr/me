+	/*
+	 * --sort=tar: the files with data first, in tar stream order, so that
+	 * their data (compressed or not) follows that order; the walk below
+	 * skips them as visited.  Files no longer in the tree (replaced by a
+	 * later entry) hold only the list's reference: skip them.
+	 */
+	err = 0;
+	while (!list_empty(&erofs_dataorder)) {
+		struct erofs_inode *inode = list_first_entry(&erofs_dataorder,
+				struct erofs_inode, i_dataorder);
+
+		list_del(&inode->i_dataorder);
+		if (!err && erofs_atomic_read(&inode->i_count) > 1 &&
+		    !erofs_inode_visited(inode)) {
+			erofs_mark_parent_inode(inode, inode->i_parent);
+			err = erofs_mkfs_handle_inode(ctx, inode);
+		}
+		erofs_iput(inode);
+	}
+	if (err)
+		return err;
+
